{
  "name": "nomuhub-crm",
  "productName": "NomuHub CRM",
  "version": "1.0.0",
  "description": "NomuHub CRM dashboard for Windows",
  "author": "NomuHub",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "latest"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "com.nomuhub.crm",
    "productName": "NomuHub CRM",
    "copyright": "NomuHub",
    "directories": { "buildResources": "build", "output": "dist" },
    "files": ["main.js", "offline.html", "build/icon.png"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.png" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NomuHub CRM",
      "artifactName": "NomuHub-CRM-Setup-${version}.${ext}"
    },
    "publish": [{ "provider": "github", "owner": "nomu-git", "repo": "booking-progress", "releaseType": "release" }]
  }
}
