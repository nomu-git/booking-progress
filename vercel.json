{
  "crons": [
    {
      "path": "/api/slack-notify",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/advisor?route=campaign-audit",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/leads",
      "destination": "/api/sheets?name=leads"
    },
    {
      "source": "/api/engagements",
      "destination": "/api/sheets?name=engagements"
    },
    {
      "source": "/api/trips",
      "destination": "/api/sheets?name=trips"
    },
    {
      "source": "/api/feedback",
      "destination": "/api/sheets?name=feedback"
    },
    {
      "source": "/mcp",
      "destination": "/api/advisor?route=mcp"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/advisor?route=protected-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "/api/advisor?route=protected-resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/advisor?route=authorization-server"
    },
    {
      "source": "/.well-known/oauth-authorization-server/:path*",
      "destination": "/api/advisor?route=authorization-server"
    },
    {
      "source": "/.well-known/openid-configuration",
      "destination": "/api/advisor?route=authorization-server"
    },
    {
      "source": "/oauth/register",
      "destination": "/api/advisor?route=register"
    },
    {
      "source": "/oauth/authorize",
      "destination": "/api/advisor?route=authorize"
    },
    {
      "source": "/oauth/token",
      "destination": "/api/advisor?route=token"
    },
    {
      "source": "/hooks/manychat",
      "destination": "/api/advisor?route=manychat"
    },
    {
      "source": "/api/campaign-audit",
      "destination": "/api/advisor?route=campaign-audit"
    },
    {
      "source": "/api/budget-plan",
      "destination": "/api/advisor?route=budget-plan"
    }
  ],
  "functions": {
    "api/sheets.js": {
      "maxDuration": 60
    },
    "api/slack-notify.js": {
      "maxDuration": 60
    },
    "api/advisor.js": {
      "maxDuration": 300
    }
  }
}
